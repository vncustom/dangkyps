# Copy to .env and adjust. All values optional (defaults shown).
SECRET_KEY=change-me-to-a-long-random-string
DB_PATH=data/dkps.db
FFMPEG_DIR=ffmpeg
USERS_CSV=tailieu chuan bi lam app/Danh sách_user.csv
DEFAULT_PASSWORD=14dth@HTV
FORCE_PASSWORD_CHANGE=0

# Storage mac dinh (co the doi o trang Admin > Cau hinh storage)
STORAGE_TYPE=ftp
FTP_HOST=127.0.0.1
FTP_PORT=2121
FTP_USER=dkps
FTP_PASS=dkps
FTP_BASE_DIR=/dkps
# 0 = xem truc tiep file goc (khong tao them ban proxy); 1 = tao proxy H.264 720p
CREATE_PROXY=0

# So bat dau (chi ap dung khi bang con trong)
TICKET_START=1
FILE_ID_START=1
