# Copy to .env and adjust. All values optional (defaults shown).
SECRET_KEY=change-me-to-a-long-random-string
DB_PATH=data/dkps.db
FFMPEG_DIR=ffmpeg
USERS_CSV=tailieu chuan bi lam app/Danh sách_user.csv
DEFAULT_PASSWORD=14dth@HTV
# Cac tai khoan admin cua app (phan cach bang dau phay)
ADMIN_USERS=admin,adminxe
FORCE_PASSWORD_CHANGE=0
# 1 = cho nguoi dung tu doi mat khau (hien link "Doi mat khau"). Mac dinh 0 = tat, chi admin dat lai mat khau.
ALLOW_PASSWORD_CHANGE=0

# Storage mac dinh (co the doi o trang Admin > Cau hinh storage)
STORAGE_TYPE=ftp
FTP_HOST=127.0.0.1
FTP_PORT=2121
FTP_USER=dkps
FTP_PASS=dkps
FTP_BASE_DIR=/dkps
# 1 = tao proxy H.264 720p (player duyet xem proxy, mac dinh); 0 = khong tao, xem truc tiep file goc
CREATE_PROXY=0

# So bat dau (chi ap dung khi bang con trong)
TICKET_START=1
FILE_ID_START=1

# Dang nhap SSO HTV (nut "Dang nhap bang HTV SSO" tren trang login)
# Secret phai giong het Dashboard SSO. De trong => tu choi moi token SSO.
HTV_SSO_SECRET=
# Co the nhieu URL cach nhau dau phay (IP / ten mien); URL dau tien dung de chuyen huong dang nhap
HTV_SSO_SERVER_URL=http://IP_Dashboard:8080
# URL ma nguoi dung dung de mo app nay (de trong = lay theo Host cua request)
HTV_SSO_APP_URL=
HTV_SSO_VERIFY_SLO=1
